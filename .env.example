# Hornet REST API (published by hornet-main.yaml on 14265)
NODE_URL=http://localhost:14265
# iota-messages-api (docker run -p 5555:5555 ...)
MESSAGES_API_URL=http://localhost:5555
# Hornet container name as seen by the messages API
HORNET_NODE_NAME=iota-hornet
# Optional live ingestion over MQTT (needs port 1883 published). Leave empty to disable.
MQTT_HOST=
MQTT_PORT=1883
# Sanity range for metrics.temperature_c
TEMP_MIN=-5
TEMP_MAX=15
